debug-logger.js:23 [2026-08-28T08:59:39.901Z] [step-orchestrator] Executing script {"stepId":"2","stepName":"Enrich detail pages","script":"const prevResult = __stepResults__['1'];\nconst repositories = prevResult.repositories;\nconst query = prevResult.query;\n\nif (!repositories || repositories.length < 5) {\n  return { failed: true, error: 'Expected at least 5 repositories from Step 1' };\n}\n\nlet currentIndex = 0;\nlet enrichedRepos = JSON.parse(JSON.stringify(repositories));\n\nif (__lastResult__ && __lastResult__.repositories && typeof __lastResult__.currentIndex === 'number') {\n  enrichedRepos = __lastResult__.repositories;\n  currentIndex = __lastResult__.currentIndex + 1;\n}\n\nif (currentIndex >= 3) {\n  // Terminal validation: exactly 5 records, every key present, records 3-4 have null defaults\n  for (let i = 0; i < 5; i++) {\n    const r = enrichedRepos[i];\n    const requiredKeys = ['name', 'owner', 'description', 'url', 'stars', 'language', 'updatedText', 'about', 'topics', 'defaultBranch'];\n    for (const key of requiredKeys) {\n      if (!(key in r)) {\n        return { failed: true, error: 'Record ' + i + ' missing required key: ' + key };\n      }\n    }\n    if (i >= 3) {\n      if (r.about !== null || !Array.isArray(r.topics) || r.topics.length !== 0 || r.defaultBranch !== null) {\n        return { failed: true, error: 'Record ' + i + ' should have about:null, topics:[], defaultBranch:null' };\n      }\n    }\n  }\n  return { query: query, repositories: enrichedRepos };\n}\n\nconst repo = enrichedRepos[currentIndex];\nlet url = repo.url;\nif (!url.startsWith('http')) {\n  url = 'https://github.com' + url;\n}\n\ntry {\n  const detail = await $openTab(url, `\n// Wait for the repo page to actually load — 'article' does not exist on GitHub\n// Use selectors that are present on every GitHub repo detail page\ntry {\n  await $wait('div.repository-content', 10000);\n} catch (e) {\n  try {\n    await $wait('div.BorderGrid', 10000);\n  } catch (e2) {\n    await $wait('main', 10000);\n  }\n}\nawait new Promise(r => setTimeout(r, 2000));\n\nlet about = null;\ntry {\n  about = await $extract('p.f4.my-3', null, 5000);\n  about = about ? about.trim() : null;\n} catch (e) {\n  try {\n    about = await $extract('div.BorderGrid-cell p.f4', null, 4000);\n    about = about ? about.trim() : null;\n  } catch (e2) {\n    try {\n      about = await $extract('div.BorderGrid-row p', null, 4000);\n      about = about ? about.trim() : null;\n    } catch (e3) {\n      about = null;\n    }\n  }\n}\n\nlet topics = [];\ntry {\n  const topicEls = await $list('a.topic-tag');\n  topics = topicEls.map(function(el) { return (el.textContent || '').trim(); }).filter(Boolean);\n} catch (e) {\n  try {\n    const topicEls = await $list('a[href*=\"/topics/\"]');\n    topics = topicEls.map(function(el) { return (el.textContent || '').trim(); }).filter(Boolean);\n  } catch (e2) {\n    topics = [];\n  }\n}\n\nlet defaultBranch = null;\ntry {\n  defaultBranch = await $extract('summary[title=\"Switch branches or tags\"] .css-truncate-target', null, 5000);\n  defaultBranch = defaultBranch ? defaultBranch.trim() : null;\n} catch (e) {\n  try {\n    defaultBranch = await $extract('button[data-hotkey=\"w\"] .css-truncate-target', null, 4000);\n    defaultBranch = defaultBranch ? defaultBranch.trim() : null;\n  } catch (e2) {\n    try {\n      defaultBranch = await $extract('#branch-picker-repos-header-ref-selector .css-truncate-target', null, 4000);\n      defaultBranch = defaultBranch ? defaultBranch.trim() : null;\n    } catch (e3) {\n      defaultBranch = null;\n    }\n  }\n}\n\nreturn { about: about, topics: topics, defaultBranch: defaultBranch };\n`);\n\n  enrichedRepos[currentIndex].about = detail.about;\n  enrichedRepos[currentIndex].topics = detail.topics;\n  enrichedRepos[currentIndex].defaultBranch = detail.defaultBranch;\n} catch (e) {\n  enrichedRepos[currentIndex].about = null;\n  enrichedRepos[currentIndex].topics = [];\n  enrichedRepos[currentIndex].defaultBranch = null;\n}\n\nreturn { done: false, query: query, repositories: enrichedRepos, currentIndex: currentIndex };","scriptLength":3870}
