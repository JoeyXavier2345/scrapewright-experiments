debug-logger.js:23 [2026-10-19T09:17:50.431Z] [step-orchestrator] Executing script {"stepId":"1","stepName":"extract search results","script":"await $wait('.Result__Of4h7n', 10000);\nconst allContainers = await $extractListMulti('.Result__Of4h7n', {\n  linkHref: { selector: '.resultContent__clhnjI a.prc-Link-Link-9ZwDx', attr: 'href' },\n  linkText: '.resultContent__clhnjI a.prc-Link-Link-9ZwDx',\n  description: '.Content__agXLbn',\n  stars: 'a.stargazersLink__uyIXyf span',\n  language: '[aria-label$=\" language\"]',\n  updatedText: '.footerItem__UC05DZ:last-child div[title] span'\n}, { allowEmpty: true });\n\nconst rawRecords = allContainers.slice(0, 5);\n\nconst records = rawRecords.map(rec => {\n  const href = rec.linkHref && rec.linkHref[0] || '';\n  const url = href.startsWith('/') ? 'https://github.com' + href : href;\n  let owner = '', name = '';\n  const parts = href.replace(/^\\//, '').split('/');\n  if (parts.length >= 2) {\n    owner = parts[0];\n    name = parts[1];\n  }\n  if (!owner && rec.linkText && rec.linkText[0]) {\n    const parts2 = rec.linkText[0].split('/');\n    owner = (parts2[0] || '').trim();\n    name = (parts2[1] || '').trim();\n  }\n  const desc = (rec.description && rec.description[0] || '').trim();\n  const stars = (rec.stars && rec.stars[0] || '').trim();\n  const lang = (rec.language && rec.language[0] || '').trim();\n  const updated = (rec.updatedText && rec.updatedText[0] || '').trim();\n  return {\n    name,\n    owner,\n    description: desc || null,\n    url,\n    stars,\n    language: lang || null,\n    updatedText: updated || null,\n    about: null,\n    topics: [],\n    defaultBranch: null,\n    rawHref: href\n  };\n});\nreturn { records, currentIndex: 0, query: __input__.query };","scriptLength":1561}
