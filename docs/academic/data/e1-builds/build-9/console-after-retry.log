rrentIndex].about = detail.about;\nrecords[currentIndex].topics = detail.topics;\nrecords[currentIndex].defaultBranch = detail.defaultBranch;\ncurrentIndex++;\n\nif (currentIndex >= 3) {\n  const finalRecords = records.map(({ rawHref, ...rest }) => rest);\n  return { query, repositories: finalRecords };\n}\n\nreturn { done: false, records, currentIndex, query };","scriptLength":2152}
